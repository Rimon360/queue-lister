{
    "manifest_version": 3,
    "name": "Queue lister with get queue id",
    "description": "",
    "options_page": "options.html",
    "version": "1.3.2",
    "permissions": [
        "storage",
        "tabs",
        "debugger",
        "activeTab",
        "cookies",
        "webRequest"
    ],
    "action": {},
    "background": {
        "service_worker": "bg.js"
    },
    "content_scripts": [
        {
            "run_at": "document_end",
            "js": [
                "content.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "js": [
                "run_first.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_start"
        }
    ],
    "incognito": "spanning",
    "host_permissions": [ 
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}